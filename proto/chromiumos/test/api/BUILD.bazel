go_proto_library(
    name = "api_go_proto",
    compilers = ["@io_bazel_rules_go//proto:go_grpc"],
    importpath = "go.chromium.org/chromiumos/config/go/test/api",
    proto = ":api_proto",
    visibility = ["//visibility:public"],
    deps = [
        "//chromiumos:go",
        "//chromiumos/build/api",
        "//chromiumos/config/api",
        "//chromiumos/config/api/test/xmlrpc",
        "//chromiumos/longrunning",
        "//chromiumos/test/lab/api",
    ],
)

go_library(
    name = "api",
    embed = [":api_go_proto"],
    importpath = "go.chromium.org/chromiumos/config/go/test/api",
    visibility = ["//visibility:public"],
)
