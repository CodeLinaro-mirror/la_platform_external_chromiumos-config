        "suite_set.proto",
        "test_case.proto",
        "test_case_metadata.proto",
        "test_case_result.proto",
        "test_execution_metadata.proto",
        "test_finder_service.proto",
        "test_harness.proto",
        "test_libs_service.proto",
        "test_suite.proto",
        "vm_leaser.proto",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//chromiumos:_go_proto",
        "//chromiumos/build/api:api_proto",
        "//chromiumos/config/api:api_proto",
        "//chromiumos/config/api/test/xmlrpc:xmlrpc_proto",
        "//chromiumos/longrunning:longrunning_proto",
