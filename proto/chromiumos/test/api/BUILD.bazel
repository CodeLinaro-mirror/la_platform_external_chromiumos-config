        "cros_publish_cli.proto",
        "cros_publish_service.proto",
        "cros_test_cli.proto",
        "cros_test_finder_cli.proto",
        "cros_test_ready_cli.proto",
        "cros_test_runner_service.proto",
        "cros_tool_runner_cli.proto",
        "cros_tool_runner_container_service.proto",
        "cros_tool_runner_container_service_extensions.proto",
        "cros_tool_runner_container_service_templates.proto",
        "ctp2.proto",
        "device_leasing.proto",
        "device_manager.proto",
        "dut_attribute.proto",
        "dut_service.proto",
        "execution_service.proto",
        "firmware_provision.proto",
        "image.proto",
        "instance.proto",
        "lacros_provision_metadata.proto",
        "plan.proto",
        "post_test_service.proto",
        "pre_test_service.proto",
