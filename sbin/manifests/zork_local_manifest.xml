<manifest>
  <remote  name="cros-internal"
           fetch="https://chrome-internal.googlesource.com"
           review="https://chrome-internal-review.googlesource.com" />
  <!-- General internal Repositories needed for firmware and OS builds -->
  <project remote="cros-internal"
           path="src/private-overlays/chromeos-partner-overlay"
           groups="minilayout,firmware"
           name="chromeos/overlays/chromeos-partner-overlay" />
  <!-- Picasso / AGESA Specific Repositories -->
  <project remote="cros-internal"
           path="src/third_party/amd-firmware/binarypi/picasso-pi"
           groups="firmware"
           name="chromeos/third_party/amd-firmware/picasso"
           revision="refs/heads/silverback"/>
  <project remote="cros-internal"
           path="src/private-overlays/chipset-picasso-private"
           groups="minilayout,firmware"
           name="chromeos/overlays/chipset-picasso-private" />
  <!-- Zork Specific Repositories -->
  <project remote="cros-internal"
           path="src/private-overlays/overlay-zork-private"
           groups="minilayout,firmware"
           name="chromeos/overlays/overlay-zork-private" />
  <!-- Repos needed for building the OS but not firmware -->
  <project remote="cros-internal"
          path="src/platform/tast-tests-private"
          name="chromeos/platform/tast-tests-private" />
  <project remote="cros-internal"
           path="src/private-overlays/project-cheets-private"
           groups="minilayout"
           name="chromeos/overlays/project-cheets-private" />
  <project remote="cros-internal"
           path="src/third_party/autotest-tests-cheets"
           groups="minilayout"
           name="chromeos/autotest-cheets" />
  <!-- Add our copy of the edk2 directory for building firmware -->
  <project  path="src/third_party/amd-firmware/binarypi/picasso-edk2"
            groups="firmware"
            name="chromiumos/third_party/edk2"
            revision="refs/heads/pco" />
<!-- Don't populate the other copies of EDK2 to save 1GB -->
  <extend-project name="chromiumos/third_party/edk2"
                  groups="firmware"
                  path="src/third_party/fsp/cml/edk2/branch1"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/fsp/cnl/edk2"
                  groups="firmware"
                  name="chromiumos/third_party/edk2"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/fsp/glk/edk2"
                  groups="firmware"
                  name="chromiumos/third_party/edk2"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/fsp/icl/edk2"
                  groups="firmware"
                  name="chromiumos/third_party/edk2"
                  revision="refs/heads/empty" />
<!-- Don't populate the other copies of kernel to save 7GB -->
  <extend-project path="src/third_party/kernel/v3.8"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v3.10"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v3.14"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v3.18"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v4.4"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v4.14"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v4.14-mistral"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v4.14-gw"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <extend-project path="src/third_party/kernel/v4.19-lakitu"
                  name="chromiumos/third_party/kernel"
                  revision="refs/heads/empty" />
  <project remote="cros-internal"
           path="src/program/zork"
           name="chromeos/program/zork"
           groups="partner-config" />
  <project remote="cros-internal"
           path="src/project/zork/berknip"
           name="chromeos/project/zork/berknip"
           groups="partner-config" />
  <project remote="cros-internal"
           path="src/project/zork/dalboz"
           name="chromeos/project/zork/dalboz"
           groups="partner-config" />
  <project remote="cros-internal"
           path="src/project/zork/ezkinil"
           name="chromeos/project/zork/ezkinil"
           groups="partner-config" />
  <project remote="cros-internal"
           path="src/project/zork/morphius"
           name="chromeos/project/zork/morphius"
           groups="partner-config" />
   <project remote="cros-internal"
           path="src/project/zork/trembyle"
           name="chromeos/project/zork/trembyle"
           groups="partner-config" />
   <project remote="cros-internal"
           path="src/project/zork/yoruk"
           name="chromeos/project/zork/yoruk"
           groups="partner-config" />
   <project remote="cros-internal"
           path="src/project/zork/zork"
           name="chromeos/project/zork/zork"
           groups="partner-config" />
</manifest>
