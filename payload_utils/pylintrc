[MAIN]

load-plugins=
    pylint.extensions.no_self_use,

ignore=
    chromiumos,
    test_data,
    experimental,
    # TODO(crbug.com/1092516): Enable linting on proto_converter files.
    factory_config_proto_converter.py,
    factory_config_proto_converter_unittest.py,
    # Linting on cros_to_al_unittest causes spurious no-name-in-module lints in
    # the checker module.
    cros_to_al_unittest.py

# Specifying 0 will auto-detect the number of processors available to use.
jobs=0

extension-pkg-whitelist=lxml

[BASIC]

good-names=
    f,
    fp,

[REPORTS]

score=no

[MESSAGES CONTROL]

disable=
    too-few-public-methods,
    no-member,
    fixme,
    consider-using-f-string,
    duplicate-code,
    possibly-used-before-assignment,
